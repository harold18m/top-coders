---
import Base from '../../layouts/Base.astro'
import DevRow from '../../components/DevRow.astro'
import { languages, fmt } from '../../lib/data.js'

export function getStaticPaths() {
  return languages()
    .filter((l) => l.devs.length >= 3)
    .map((l) => ({ params: { lang: l.slug }, props: { l } }))
}

const { l } = Astro.props
const byCountry = [...l.devs.reduce((m, u) => {
  const cur = m.get(u.country) || { name: u.countryName, flag: u.flag, slug: u.country, stars: 0, devs: 0 }
  cur.stars += u.langStars
  cur.devs += 1
  return m.set(u.country, cur)
}, new Map()).values()].sort((a, b) => b.stars - a.stars).slice(0, 10)
---

<Base
  title={`Top coders de ${l.name} — ranking por lenguaje`}
  description={`Los desarrolladores con más impacto en ${l.name} según sus repos públicos en GitHub.`}
>
  <section class="hero" style="padding-bottom:20px">
    <h1>
      <span class="dot" style={`display:inline-block;width:16px;height:16px;border-radius:50%;margin-right:14px;background:${l.color || '#666'}`}></span>
      <em>{l.name}</em>
    </h1>
    <p>{l.devs.length} desarrolladores con al menos un repo público en {l.name}, ordenados por estrellas acumuladas en ese lenguaje.</p>
    <div class="stat-strip">
      <div><b>{fmt(l.stars)}</b><small>estrellas en {l.name}</small></div>
      <div><b>{byCountry.length}</b><small>países</small></div>
    </div>
  </section>

  <section>
    <div class="sec-head"><h2>Por país</h2></div>
    <div class="chips">
      {byCountry.map((c) => (
        <a class="chip" href={`/${c.slug}`}>{c.flag} <b>{c.name}</b> <small>{fmt(c.stars)} ★</small></a>
      ))}
    </div>
  </section>

  <section>
    <div class="sec-head">
      <h2>Ranking</h2>
      <p>ordenado por estrellas en repos de {l.name}</p>
    </div>
    <div class="devs">
      {l.devs.slice(0, 60).map((u, i) => <DevRow user={u} rank={i + 1} showCountry />)}
    </div>
  </section>
</Base>
