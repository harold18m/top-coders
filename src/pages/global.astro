---
import Base from '../layouts/Base.astro'
import DevRow from '../components/DevRow.astro'
import { globalTop, countries, fmt, allUsers } from '../lib/data.js'

const top = globalTop.slice(0, 100)
const represented = new Set(top.map((u) => u.country)).size
---

<Base
  title="Top 100 de América Latina — ranking general de GitHub"
  description="Los 100 desarrolladores latinoamericanos con mayor impacto open source, sin separar por país."
>
  <section class="hero" style="padding-bottom:20px">
    <h1>Los 100 de <em>LATAM</em></h1>
    <p>
      Mismo score, mismos pesos, todos los países en la misma tabla. El score usa
      referencias fijas en escala logarítmica, así que no depende de contra quién
      te toque competir.
    </p>
    <div class="stat-strip">
      <div><b>{fmt(allUsers.length)}</b><small>devs analizados</small></div>
      <div><b>{countries.length}</b><small>países medidos</small></div>
      <div><b>{represented}</b><small>países en el top 100</small></div>
    </div>
  </section>

  <section>
    <div class="devs">
      {top.map((u, i) => <DevRow user={u} rank={i + 1} showCountry />)}
    </div>
  </section>
</Base>
